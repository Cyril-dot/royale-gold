# Royale Gold — environment variables.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# No real secrets ship in this repo — placeholders only.

# Postgres connection string (production + `prisma db push` / migrate).
# Example for Neon: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/royale_gold"

# Secret used to sign the JWT session cookie (jose HS256).
# Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-secret"

# Email OTP (Gmail SMTP via nodemailer) — required for registration.
# The code mail is sent from this Gmail address.
SMTP_USER=royalgolld@gmail.com
SMTP_PASS=
# Optional: the From address shown on the code email (defaults to SMTP_USER).
SMTP_FROM=
