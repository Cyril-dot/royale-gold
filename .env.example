# Royale Gold — environment variables.
# Copy to `.env` and fill in real values. NEVER commit a real `.env`.
# No real secrets ship in this repo — placeholders only.

# Postgres connection string (production + `prisma db push` / migrate).
# Example for Neon: postgresql://<user>:<password>@<host>/<db>?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/royale_gold"

# Secret used to sign the JWT session cookie (jose HS256).
# Generate one with: openssl rand -base64 32
JWT_SECRET="change-me-to-a-long-random-secret"

# Gmail SMTP via nodemailer — the OWNER email sender (the owner
# panel's "Email customers" page). The mail is sent from this Gmail address.
SMTP_USER=royalgolld@gmail.com
SMTP_PASS=
# Optional: the From address shown on the owner mail (defaults to SMTP_USER).
SMTP_FROM=

# Flutterwave v3 (Nigeria only) — optional fallbacks. The keys are
# normally pasted in the owner panel (Gateway Settings), encrypted in
# the DB with GATEWAY_ENCRYPTION_KEY; these env vars are only read
# when the DB has nothing saved. The webhook secret hash is the one
# set in the Flutterwave dashboard (Settings → Webhooks) — it must
# match the value saved in the panel, or every webhook is rejected.
# FLUTTERWAVE_PUBLIC_KEY=
# FLUTTERWAVE_SECRET_KEY=
# FLUTTERWAVE_WEBHOOK_SECRET=
# Optional: override the Flutterwave API base (default https://api.flutterwave.com/v3).
# FLUTTERWAVE_API_BASE_URL=

# Gateway encryption key — AES-256-GCM for the gateway keys saved in
# the owner panel (PayTeller + Flutterwave). Set once in Vercel and
# NEVER change it — the saved keys are encrypted with SHA-256 of it.
# GATEWAY_ENCRYPTION_KEY=
