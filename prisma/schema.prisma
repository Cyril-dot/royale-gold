// Royale Gold — Prisma schema (PostgreSQL, production).
// Local dev on this VM has no Postgres; see README.md "Local database"
// for the clearly-labelled SQLite stand-in (prisma/schema.sqlite.prisma).
// NEVER point DATABASE_URL at invented Neon credentials.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Prisma 7: the connection URL lives in prisma.config.ts (datasource.url),
  // not here. The runtime client gets it via the pg adapter (src/lib/prisma.ts).
}

enum Role {
  owner
  admin
  user
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String?  @unique
  phone            String?
  passwordHash     String
  role             Role     @default(user)
  // REAL cash wallet (GH₵). Demo accounts start at 250.00.
  cashBalance      Decimal  @default(250.00) @db.Decimal(12, 2)
  // SIM / demo-play balance (GH₵). Separate from cash; daily SIM claim tops this up.
  simBalance       Decimal  @default(1000.00) @db.Decimal(12, 2)
  coins            Int      @default(10)
  commissionPct    Decimal? @db.Decimal(5, 2)
  active           Boolean  @default(true)
  referredByAdminId String?
  referredByAdmin  User?    @relation("ReferredUsers", fields: [referredByAdminId], references: [id])
  referredUsers    User[]   @relation("ReferredUsers")
  referralCodeUsed String?
  xp               Int      @default(0)
  level            Int      @default(1)
  createdAt        DateTime @default(now())

  referralCodes   ReferralCode[]
  redemptions     Redemption[]
  deposits        DepositEvent[] @relation("Depositor")
  adminDeposits   DepositEvent[] @relation("CommissionAdmin")
  gameResults     GameResult[]
  dailyClaims     DailyClaim[]
  achievements    Achievement[]
}

model ReferralCode {
  id        String   @id @default(cuid())
  code      String   @unique
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  redemptions Redemption[]
}

model Redemption {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeId    String
  code      ReferralCode @relation(fields: [codeId], references: [id])
  coins     Int      @default(5)
  createdAt DateTime @default(now())

  // One referral redemption per user, ever.
  @@unique([userId])
}

model DepositEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("Depositor", fields: [userId], references: [id], onDelete: Cascade)
  adminId    String?
  admin      User?    @relation("CommissionAdmin", fields: [adminId], references: [id])
  amount     Decimal  @db.Decimal(12, 2)
  method     String
  // Commission % in force at deposit time — frozen forever, never recomputed.
  pctInForce Decimal  @db.Decimal(5, 2)
  commission Decimal  @db.Decimal(12, 2)
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([userId, createdAt])
}

model GameResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      String
  currency  String
  stake     Decimal  @db.Decimal(12, 2)
  payout    Decimal  @db.Decimal(12, 2)
  result    Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([game, createdAt])
}

model DailyClaim {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  claimedDate String
  streakDay   Int
  createdAt   DateTime @default(now())

  @@unique([userId, type, claimedDate])
  @@index([userId, type])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
}

model TriviaQuestion {
  id          String @id @default(cuid())
  question    String
  options     Json
  answerIndex Int
  category    String
}
