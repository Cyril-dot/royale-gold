// Royale Gold — Prisma schema (PostgreSQL, production).
// Local dev on this VM has no Postgres; see README.md "Local database"
// for the clearly-labelled SQLite stand-in (prisma/schema.sqlite.prisma).
// NEVER point DATABASE_URL at invented Neon credentials.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // DEV-ONLY sqlite stand-in. Generated by scripts/make-sqlite-schema.mjs — do not edit by hand.
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String?  @unique
  phone            String?
  passwordHash     String
  role             String   @default("user")
  // Phase 1 country-based (Nov 2026): ISO country code chosen at
  // register ("GH" | "NG"), and the fiat currency derived from it.
  // Stored on the row so money code never re-derives it. Existing
  // users default GH / GHS. Currency is IMMUTABLE after register
  // (no self-serve switch — a switch would strand balances and
  // break the decay / commission math).
  country          String?
  currency         String   @default("GHS")
  // REAL cash wallet (in the user's currency — see User.currency).
  // Demo accounts start at 250.00.
  cashBalance      Float  @default(250.00)
  // SIM / demo-play balance (in the user's currency). Separate from
  // cash; daily SIM claim tops this up.
  simBalance       Float  @default(1000.00)
  coins            Int      @default(10)
  commissionPct    Float?
  active           Boolean  @default(true)
  // P0 Batch 1 (A8): a blocked player cannot bet or deposit. The block
  // is set by an admin (own downline only) with a mandatory reason.
  blockedAt        DateTime?
  blockedReason    String?
  // P0 Batch 3 (O2/O3): per-section permissions as a JSON array of section
  // keys (see src/lib/rbac.ts ADMIN_SECTIONS). Null = all sections allowed
  // (backwards compatible: existing admins keep full access).
  permissions      String?
  // P0 Batch 3 (O15): session version — bumped to kill ALL of this user's
  // sessions at once (deactivate, "Kill all sessions"). A JWT carrying an
  // older version is rejected by getSessionUser (src/lib/auth.ts).
  sessionVersion   Int      @default(0)
  // P0 Batch 3 (A13): TOTP two-factor auth (opt-in per admin/owner).
  // totpSecret is the base32 secret; totpEnabled only flips after a code
  // is verified against it. The secret is never returned by any endpoint
  // after setup.
  totpSecret       String?
  totpEnabled      Boolean  @default(false)
  referredByAdminId String?
  referredByAdmin  User?    @relation("ReferredUsers", fields: [referredByAdminId], references: [id])
  referredUsers    User[]   @relation("ReferredUsers")
  // P1 Batch 4 (O24): agent hierarchy — an admin can have a PARENT
  // admin (a senior agent). The parent sees their own downline PLUS
  // their child admins' downlines as a read-only rollup on the parent's
  // Overview / Commission / Players pages. Optional — an admin with no
  // parent works exactly as before.
  parentAdminId String?
  parentAdmin   User?  @relation("AdminHierarchy", fields: [parentAdminId], references: [id])
  childAdmins   User[] @relation("AdminHierarchy")
  referralCodeUsed String?
  xp               Int      @default(0)
  level            Int      @default(1)
  createdAt        DateTime @default(now())
  // P2 Batch 2 (O28): the player's birthday (optional, set on the
  // account page) — the owner pays a birthday bonus once a year to
  // players whose birthday is today. Stored as a date (UTC midnight);
  // only the month + day are used for the bonus.
  birthday         DateTime?

  referralCodes   ReferralCode[]
  redemptions     Redemption[]
  deposits        DepositEvent[] @relation("Depositor")
  adminDeposits   DepositEvent[] @relation("CommissionAdmin")
  conversions     ConversionEvent[]
  gameResults     GameResult[]
  dailyClaims     DailyClaim[]
  achievements    Achievement[]
  // P0 Batch 1: withdrawals (request only — no real money moves),
  // manual balance adjustments, and the audit trail.
  withdrawals      Withdrawal[]       @relation("Withdrawer")
  adminWithdrawals Withdrawal[]       @relation("WithdrawalAdmin")
  adjustments      BalanceAdjustment[]
  adminAdjustments BalanceAdjustment[] @relation("AdjustmentAdmin")
  // Phase 2 PayTeller (Nov 2026): the hosted-checkout payments for
  // this player. Opposite side of PaytellerPayment.user.
  paytellerPayments PaytellerPayment[]
  // Nov 2026 Theteller (PaySwitch) direct MoMo push: one row per
  // push attempt. Opposite side of ThetellerPayment.user.
  thetellerPayments ThetellerPayment[]
  // Nov 2026: the player's ONE saved withdrawal account (bank or
  // MoMo) — set on the convert page, snapshotted onto each request.
  withdrawalAccount WithdrawalAccount?
  auditEntries     AuditLog[]          @relation("AuditActor")
  // P0 Batch 3 (O4): commission rules for this admin (a rule with adminId
  // null is the global default, not tied to a user). (O5) payouts received.
  commissionRules  CommissionRule[]    @relation("RuleAdmin")
  payouts          CommissionPayout[]  @relation("PayoutAdmin")
  // P0 Batch 3 (A11): tickets this player opened, and tickets assigned to
  // this admin (their own players' tickets only).
  ticketsOpened    Ticket[]            @relation("TicketPlayer")
  ticketsAssigned  Ticket[]            @relation("TicketAdmin")
  ticketMessages   TicketMessage[]
  // P1 Batch 1 (A18): promo codes this admin created + codes redeemed.
  promoCodesCreated PromoCode[]      @relation("PromoCreator")
  promoRedemptions  PromoRedemption[]
  // P1 Batch 1 (A19): notes/tags on this player + notes/tags this admin wrote.
  notesReceived     PlayerNote[]      @relation("NotePlayer")
  notesAuthored     PlayerNote[]      @relation("NoteAuthor")
  tagsReceived      PlayerTag[]       @relation("TagPlayer")
  tagsAuthored      PlayerTag[]       @relation("TagAuthor")
  // P1 Batch 1 (A20): per-player limits (one row per player, or none).
  limits            PlayerLimit?
  // P1 Batch 2 (A21): KYC submissions this player made + ones this admin reviewed.
  kycSubmissions KycSubmission[] @relation("KycPlayer")
  kycReviews     KycSubmission[] @relation("KycReviewer")
  // P1 Batch 2 (A23): in-app notifications received + sent by this admin.
  notificationsReceived Notification[] @relation("NotificationPlayer")
  notificationsSent     Notification[] @relation("NotificationAdmin")
  // P1 Batch 3 (O19): promotions this owner created, promotions
  // targeting this admin's downline, and promotion grants received.
  promotionsCreated Promotion[]     @relation("PromotionCreator")
  promotionsTargeted Promotion[]    @relation("PromotionTarget")
  promotionGrants   PromotionGrant[]
  // P1 Batch 4 (O20): announcements this owner created.
  announcementsCreated Announcement[] @relation("AnnouncementCreator")
  // P2 Batch 1 (A25/A26/A27): campaigns, VIP tiers and tournaments
  // this admin/owner created; tournaments won; frozen entries.
  campaignsCreated   Campaign[]        @relation("CampaignCreator")
  vipTiersCreated    VipTier[]         @relation("VipTierCreator")
  tournamentsCreated Tournament[]      @relation("TournamentCreator")
  tournamentsWon     Tournament[]      @relation("TournamentWinner")
  tournamentEntries  TournamentEntry[]
  // P2 Batch 2 (O28/O29/O31/O33): jackpots, risk rules and brands this
  // owner created; birthday bonuses paid to this player.
  jackpotsCreated    Jackpot[]          @relation("JackpotCreator")
  riskRulesCreated   RiskRule[]         @relation("RiskRuleCreator")
  brandsCreated      Brand[]            @relation("BrandCreator")
  birthdayBonusGrants BirthdayBonusGrant[]
}

model ReferralCode {
  id        String   @id @default(cuid())
  code      String   @unique
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  redemptions Redemption[]
}

model Redemption {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeId    String
  code      ReferralCode @relation(fields: [codeId], references: [id])
  coins     Int      @default(5)
  createdAt DateTime @default(now())

  // One referral redemption per user, ever.
  @@unique([userId])
}

model DepositEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("Depositor", fields: [userId], references: [id], onDelete: Cascade)
  adminId    String?
  admin      User?    @relation("CommissionAdmin", fields: [adminId], references: [id])
  amount     Float 
  method     String
  // Phase 1 country-based (Nov 2026): the fiat this deposit was made
  // in. Aggregates MUST filter/group by this — never sum across fiats.
  fiatCurrency String @default("GHS")
  // Commission % in force at deposit time — frozen forever, never recomputed.
  pctInForce Float 
  commission Float 
  // Phase 2 PayTeller (Nov 2026): the verified provider response for
  // a gateway deposit (merchant_net, platform_commission,
  // customer_total, …). Demo deposits leave this null.
  providerPayload Json?
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([userId, createdAt])
}

model ConversionEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // REAL cash debited — in the user's fiat (see User.currency).
  // SIM is never involved in conversions.
  cashDebited Float 
  // Phase 1 country-based (Nov 2026): the fiat the cash was debited in.
  fiatCurrency String @default("GHS")
  // Coins credited at the fixed rate GH₵5 = 1 coin. One-way only:
  // coins are never withdrawable or convertible back to cash.
  coinsGained Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model GameResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      String
  currency  String
  // Phase 1 country-based (Nov 2026): the FIAT this round was played
  // in ("GHS" | "NGN" | ...). `currency` above stays "cash" | "coins"
  // (wallet type) — NEVER reuse it for fiat.
  fiatCurrency String @default("GHS")
  stake     Float 
  payout    Float 
  result    Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([game, createdAt])
}

model DailyClaim {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  claimedDate String
  streakDay   Int
  createdAt   DateTime @default(now())

  @@unique([userId, type, claimedDate])
  @@index([userId, type])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
}

model TriviaQuestion {
  id          String @id @default(cuid())
  question    String
  options     Json
  answerIndex Int
  category    String
  // Trivia difficulty (Nov 2026): easy | medium | hard. The player picks
  // the difficulty before a round; the questions endpoint deals only
  // from that pool. Easy 20s/question, medium 15s, hard 10s.
  difficulty  String @default("medium")
}

// P0 Batch 1 (A5/O8): a withdrawal is a REQUEST only — no real money
// moves (deposits are demo cashier only). Status flow:
//   pending -> approved (admin approves; small amounts end here)
//   pending -> admin_approved (admin approves a LARGE amount) -> approved (owner approves second)
//   pending | admin_approved -> rejected (admin or owner, reason required)
// Large = over WITHDRAWAL_OWNER_THRESHOLD (GH₵ 500, src/lib/withdrawals.ts).
model Withdrawal {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("Withdrawer", fields: [userId], references: [id], onDelete: Cascade)
  // Referring admin at request time — scopes the admin queue. Null when
  // the player was not referred; the owner sees those in the global queue.
  adminId         String?
  admin           User?     @relation("WithdrawalAdmin", fields: [adminId], references: [id])
  amount          Float  
  method          String
  // Nov 2026: snapshot of the player's saved withdrawal account at
  // request time — the admin queue shows it even if the account
  // changes later. Null when no account was saved (requests still work).
  accountType     String?
  accountName     String?
  accountDetail   String?
  // Phase 1 country-based (Nov 2026): the fiat requested, in the
  // player's currency.
  fiatCurrency    String    @default("GHS")
  status          String    @default("pending")
  adminApprovedAt DateTime?
  decidedBy       String?
  reason          String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([adminId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// Nov 2026: the player's ONE saved withdrawal account — bank or MoMo.
// Set on the convert page; each withdrawal request snapshots it, so the
// admin queue shows where the money goes even if the account changes
// later. Re-saving replaces it. Values live here only — the audit log
// records the save, never the account details.
model WithdrawalAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type          String   // "bank" | "momo"
  bankName      String?
  accountNumber String?
  accountName   String
  network       String?  // "MTN" | "Telecel" | "AirtelTigo" (momo only)
  phoneNumber   String?
  updatedAt     DateTime @updatedAt
}

// P0 Batch 1 (A7): a manual balance adjustment by an admin (own downline
// only). Written atomically with the balance change and an AuditLog row;
// the ledger (A6/O7) reads these back. Reason is mandatory.
// P1 Batch 1: kind distinguishes the flavour — "adjustment" (manual,
// A7), "bonus" (a bonus grant, A17) or "promo" (a promo-code redemption,
// A18). The ledger renders each kind differently so a bonus is never
// mistaken for a manual adjustment.
model BalanceAdjustment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User     @relation("AdjustmentAdmin", fields: [adminId], references: [id])
  wallet    String   // "cash" | "coins"
  direction String   // "credit" | "debit"
  amount    Float 
  reason    String
  // Phase 1 country-based (Nov 2026): the fiat of a cash adjustment
  // (the target player's currency; coin adjustments carry the
  // player's fiat too, for the ledger).
  fiatCurrency String @default("GHS")
  kind      String   @default("adjustment") // "adjustment" | "bonus" | "promo"
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

// P0 Batch 1: the audit trail for money/admin actions (adjustments,
// blocks, withdrawal decisions). Append-only — nothing edits these rows.
// P0 Batch 3 extends the action set: commission.rule.* (rules engine),
// commission.payout (settlement), admin.permission / admin.kill_sessions /
// admin.deactivate, auth.2fa.enable / auth.2fa.disable, ticket.create /
// ticket.reply / ticket.close.
// P2 Batch 2 (O28/O29/O30/O31/O33) extends it further: loyalty.birthday
// (birthday bonus paid), jackpot.create / jackpot.toggle / jackpot.pay,
// risk.rule.create / risk.rule.toggle / risk.rule.hold / risk.rule.block,
// cms.save, brand.create / brand.toggle.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id])
  action    String   // "balance.adjust" | "user.block" | "user.unblock" | "withdrawal.approve" | "withdrawal.reject" | "withdrawal.request" | "commission.rule.set" | "commission.payout" | "admin.permission" | "admin.kill_sessions" | "admin.deactivate" | "auth.2fa.enable" | "auth.2fa.disable" | "ticket.create" | "ticket.reply" | "ticket.close" | "bonus.grant" | "promo.create" | "promo.redeem" | "player.note.add" | "player.tag.add" | "player.tag.remove" | "player.limit.set" | "kyc.submit" | "kyc.approve" | "kyc.reject" | "notification.send" | "promotion.create" | "promotion.grant" | "promotion.cashback" | "promotion.toggle" | "announcement.create" | "announcement.toggle" | "platform.settings" | "kyc.settings" | "ticket.reassign" | "admin.parent.set" | "campaign.send" | "tournament.create" | "tournament.end" | "player.break" | "vip.tier.set" | "deposit.fixed_amount" | "win.rate"
  targetId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// P0 Batch 3 (O4): the commission rules engine. Replaces the flat % per
// admin (User.commissionPct, kept as the legacy fallback). One rule per
// admin per model, versioned by effectiveFrom — the rule in force on a
// day (latest effectiveFrom <= that day) is what that day pays. A rule
// with adminId null is the GLOBAL default: it applies to every admin
// without their own rule. model: "revshare" (% of the player's net loss
// = stakes - payouts) or "turnover" (% of total stakes). Rate is a %
// (e.g. 10 = 10%). Rules are never deleted — a new rule supersedes the
// old one from its effectiveFrom date, so past days stay frozen.
// P1 Batch 4 (O24): parentSharePct — when this admin has a PARENT
// admin, the parent takes this % of the admin's commission as a
// REPORTING line on the settlement (shown, never deducted from the
// child's payout). Default 0 = no split.
model CommissionRule {
  id            String   @id @default(cuid())
  adminId       String?
  admin         User?    @relation("RuleAdmin", fields: [adminId], references: [id])
  model         String   // "revshare" | "turnover"
  rate          Float 
  parentSharePct Float @default(0)
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([adminId, effectiveFrom])
}

// P0 Batch 3 (O5): commission settlement & payouts. A payout is the owner
// recording that commission was actually paid to an admin (amount +
// method + reference). Owed per admin per period is RECOMPUTED from the
// ledger (src/lib/commission.ts); paid is the sum of these rows; balance
// = owed - paid. A payout writes to the ledger (type "payout") and the
// AuditLog, so the numbers cannot disagree.
model CommissionPayout {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("PayoutAdmin", fields: [adminId], references: [id])
  amount     Float 
  method     String   // e.g. "MTN", "Telecel", "AirtelTigo", "bank", "cash"
  // Phase 1 country-based (Nov 2026): the fiat this payout was made in.
  fiatCurrency String @default("GHS")
  reference  String?
  periodFrom String?  // "YYYY-MM-DD" — the period this payout covers
  periodTo   String?
  createdBy  String   // owner id who recorded it
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
}

// P0 Batch 3 (A11): support tickets — tickets + replies only, no live
// chat. A player opens a ticket from the account page; it is assigned to
// their referring admin (adminId null when the player was not referred —
// the owner sees those). Status: "open" -> "answered" -> "closed".
model Ticket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("TicketPlayer", fields: [userId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     User?    @relation("TicketAdmin", fields: [adminId], references: [id])
  subject   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  @@index([adminId, status, createdAt])
  @@index([userId, createdAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  senderRole String  // "user" | "admin"
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// P0 Batch 2 (O9/O10/O11): per-game owner control. One row per game the
// owner has touched; a game with NO row runs on the catalogue defaults
// (src/lib/games.ts): visible, not killed, no bet/payout caps, the
// catalogue maxMultiplier. Null numeric = no override (use the default).
model GameConfig {
  slug          String   @id // matches games.ts slug
  visible       Boolean  @default(true)
  killed        Boolean  @default(false)
  minBet        Float?
  maxBet        Float?
  maxPayout     Float?
  maxMultiplier Float?
  updatedBy     String?
  updatedAt     DateTime @updatedAt
}

// Win controls (Nov 2026): the owner's PER-GAME WIN CHANCE — the base
// win probability (%) for one game, set in the game settings. No row =
// unset = today's behaviour for that game. The LIVE factor still
// applies ON TOP of it (base x factor). Enforced ONLY where the server
// draws the outcome (PLAY_GATED_GAMES — Royale Roulette today); other
// games decide wins in the room, so the value is never read for them
// and the owner panel refuses to save one. Reads are P2021/P2022-safe
// in src/lib/game-config.ts. Kept OUT of GameConfig on purpose: that
// table is read unselected (getGameConfig), so a new column there
// would 500 every game-config read in prod until the SQL runs.
model GameWinChance {
  slug      String   @id // matches games.ts slug
  chancePct Float  // percent, e.g. 40.00 = 40%
  updatedAt DateTime @updatedAt
}

// P0 Batch 2 (O12): per-method deposit control. Rows are seeded lazily
// (a method with no row is enabled with no min/max). Deposits stay demo
// cashier only — this toggles/limits the methods, it connects no gateway.
model PaymentMethodConfig {
  method       String // "MTN" | "Telecel" | "AirtelTigo" | "card"
  // Phase 1 country-based (Nov 2026): one row per (method, fiat).
  // The demo cashier reads the row for the player's currency; a
  // gateway row (Phase 2) carries the gateway name here.
  fiatCurrency String @default("GHS")
  gateway      String? // null = demo cashier; "payteller" in Phase 2
  enabled      Boolean  @default(true)
  minDeposit   Float?
  maxDeposit   Float?
  updatedAt    DateTime @updatedAt

  @@id([method, fiatCurrency])
}

// Phase 1 country-based (Nov 2026): per-currency platform rules —
// one row per fiat (GHS, NGN, ...). The owner's CurrencyConfig editor
// (owner panel) edits these, so Chuks sets NGN limits without a code
// change. This is the source of truth for min deposit / min stake /
// the cash→coins rate; PlatformSettings keeps the GHS row's values as
// its legacy fields and the two are kept in sync on write.
//   decayStep — the LIVE win-chance decay step for this fiat:
//     GHS 100, NGN 10,000 (same "effort", 100x scale).
//   withdrawalOwnerThreshold — withdrawals above this need the
//     owner's second approval: GHS 500, NGN 50,000.
// Seed values are defaults Chuks can change in the owner panel.
model CurrencyConfig {
  currency                 String   @id // "GHS" | "NGN" | ...
  symbol                   String // "GH₵" | "₦" | ...
  minDeposit               Float 
  minStake                 Float 
  conversionRate           Float  // fiat per 1 coin
  decayStep                Float  @default(100)
  withdrawalOwnerThreshold Float  @default(500)
  enabled                  Boolean  @default(true)
  updatedAt                DateTime @updatedAt
}

// Fixed deposit amount (Nov 2026, owner feature): when a row exists
// for a fiat, EVERY deposit in that fiat must be exactly `amount` —
// no other amount is allowed (server-enforced in the demo cashier +
// PayTeller create; the DepositModal locks to it). No row = OFF
// (current behaviour: any amount >= min deposit). Separate table on
// purpose: prod Neon will not have it until Chuks runs
// rg-fixed-deposit.sql, and a missing column on CurrencyConfig would
// 500 every getCurrencyConfig read site-wide — a missing table here
// degrades to OFF (getFixedDepositAmount catches P2022) and only the
// set endpoint 503s.
model FixedDeposit {
  currency  String   @id // "GHS" | "NGN" | ...
  amount    Float 
  updatedAt DateTime @updatedAt
}

// Win logic (Nov 2026, owner feature) — the owner's per-fiat win rate:
// a deposit of D creates a win allowance of D x rate%. Total game
// winnings from that deposit, across ALL games, cannot exceed its
// allowance. Rate row absent = OFF (no cap, current behaviour).
// Reads are P2022-safe in src/lib/win-logic.ts — a prod DB without
// these tables behaves as OFF and never 500s.
model WinRate {
  currency  String   @id // "GHS" | "NGN" | ...
  ratePct   Float  // percent, e.g. 20.00 = 20%
  updatedAt DateTime @updatedAt
}

// Win controls (Nov 2026): the owner's RANDOM WIN EXCEPTION chance
// per fiat — the percent of cash wins that bypass the win-allowance
// cap entirely (full natural profit credited, allowance untouched
// for that win). No row = OFF = the cap always applies. Reads are
// P2021/P2022-safe in src/lib/win-logic.ts (same pattern as WinRate).
model WinException {
  currency  String   @id // "GHS" | "NGN" | ...
  chancePct Float  // percent, e.g. 5.00 = 5%
  updatedAt DateTime @updatedAt
}

// Running win allowance per user per fiat: topped up on each deposit
// (deposit x rate in force at deposit time), drained as winnings are
// credited. Exhausted (0) = no more wins until the next deposit.
model WinAllowance {
  userId       String
  fiatCurrency String   @default("GHS")
  remaining    Float 
  updatedAt    DateTime @updatedAt

  @@id([userId, fiatCurrency])
}

// Winnings sub-ledger: the part of the user's cashBalance that came
// from game profits (payout - stake). Displayed Stake = cashBalance -
// winnings. Invariant: 0 <= winnings <= cashBalance, enforced by
// clampWinnings() after every cash debit (settle loss, convert,
// admin adjust). Manual credits (bonus, jackpot, cashback, promo
// match) land in the Stake portion, never here.
model WinWallet {
  userId       String   @id
  fiatCurrency String   @default("GHS")
  winnings     Float 
  updatedAt    DateTime @updatedAt
}

// Payment blocks (Nov 2026, port of BetWins): two failed PayTeller
// deposits in 24h blocks the account AND the MoMo number on file from
// deposits for 24h. The block is a ROW (not derived from the failure
// log) so the owner can list it and lift it early. Reads are
// P2021/P2022-safe in src/lib/payment-blocks.ts — a prod DB without
// these tables behaves as unblocked and never 500s.
model PaymentBlock {
  id           String   @id @default(cuid())
  userId       String
  phoneNumber  String?
  blockedUntil DateTime
  reason       String?
  createdAt    DateTime @default(now())

  @@index([userId, blockedUntil])
  @@index([phoneNumber, blockedUntil])
}

// One genuine PayTeller deposit failure (deduped by depositRef — the
// PaytellerPayment.reference, so a webhook + poll twin can never count
// twice). A completed deposit does not reset anything: old failures
// age out of the 24h window on their own.
model DepositFailure {
  id          String   @id @default(cuid())
  userId      String
  phoneNumber String?
  depositRef  String   @unique
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Deposit MoMo number (Nov 2026): the number a PayTeller MoMo prompt
// goes to, set ONCE on the user's first PayTeller deposit and reused
// after that — changed only on the Account page, never re-typed per
// deposit. Own table (not a User column) on purpose: getSessionUser
// reads the whole User row unselected, so a User column missing in
// prod would 500 every authenticated request; a missing table here
// just degrades to "ask once" (P2021/P2022-safe reads below).
model DepositNumber {
  userId    String   @id
  phone     String
  updatedAt DateTime @updatedAt
}

// Phase 1 country-based (Nov 2026): gateway credentials + the Ghana
// MoMo gateway toggle. Created NOW so Phase 2 (PayTeller) has
// somewhere to write — the PayTeller fields stay EMPTY this phase.
// Phase 2 stores the values AES-256-GCM encrypted (same pattern as
// BetWins payment_settings) — never plain text, never logged.
model GatewaySettings {
  id                     String   @id @default("global")
  paytellerApiKey        String?
  paytellerMerchantId    String?
  paytellerUsername      String?
  paytellerWebhookSecret String?
  thetellerApiUser       String?
  thetellerApiKey        String?
  thetellerMerchantId    String?
  thetellerCallbackSecret String?
  thetellerBaseUrl       String?
  ghMomoGateway          String   @default("payteller") // "demo" | "theteller" | "payteller"
  updatedAt              DateTime @updatedAt
}

// Phase 2 PayTeller (Nov 2026): one row per hosted-checkout payment.
// Reference RG-<16 hex> is PayTeller's idempotency key (unique per
// payment; retrying it with identical details returns the original).
// The wallet is credited with the FULL principal — the house absorbs
// the 10% PayTeller charge (BetWins rule). merchantNet /
// platformCommission / customerTotal / customerFee are recorded for
// reconciliation and are NEVER the credit.
model PaytellerPayment {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  reference          String   @unique // RG-<16 hex>
  paytellerId        String? // PayTeller's payment id (for /verify)
  amount             Float  // principal, GHS
  fiatCurrency       String   @default("GHS")
  merchantNet        Float?
  platformCommission Float?
  customerTotal      Float? // what the customer authorized (principal + 2% fee)
  customerFee        Float? // the 2% Theteller fee
  status             String   @default("pending") // pending|processing|successful|failed|expired
  checkoutUrl        String?
  expiresAt          DateTime?
  providerPayload    Json?
  completedAt        DateTime?
  createdAt          DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

// Phase 2 PayTeller (Nov 2026): the webhook dedup table. The event id
// is the primary key — the unique constraint IS the dedup (PayTeller
// delivers at least once, 8 attempts). paymentId is a loose string
// reference (no FK) so a stray event can still be recorded.
model PaytellerWebhookEvent {
  eventId    String   @id // PayTeller event id, e.g. "payment-<uuid>"
  paymentId  String?
  eventType  String
  receivedAt DateTime @default(now())
}

// Nov 2026 Theteller (PaySwitch) direct MoMo push: one row per push
// attempt. transactionId is the 12-digit id sent to Theteller — the
// idempotency and lookup key (unique per attempt; a retry is always a
// NEW transaction_id, never a reuse). amountPesewas is the exact wire
// value (integer pesewas); amount is the principal in GHS for the
// credit math. The wallet is credited the FULL principal — the house
// absorbs Theteller's merchant-side charge, same money rule as
// PayTeller. The voucher code (Telecel) is NEVER stored. status:
// pending | successful | failed. chargeState: "queued" (row created,
// charge not started yet) | "called" (process answered or the call
// failed). A "queued" row older than 30s is failed by the status poll
// as "could not be started" — no charge ever happened, so no money
// moved and no block failure is recorded for it.
model ThetellerPayment {
  id               String   @id @default(cuid())
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactionId    String   @unique // 12 digits
  amount           Float // principal, GHS
  amountPesewas    Int // exact wire value, integer pesewas
  fiatCurrency     String   @default("GHS")
  network          String // "MTN" | "VDF" | "ATL" | "TGO" (r-switch)
  subscriberNumber String // local 0-format, e.g. 0244000000
  status           String   @default("pending") // pending|successful|failed
  chargeState      String   @default("queued") // queued|called
  reason           String?
  providerPayload  Json?
  completedAt      DateTime?
  createdAt        DateTime @default(now())

  @@index([userId, createdAt])
  @@index([status])
}

// P0 Batch 2 (O11 global kill + O13 wallet config): the platform's
// single settings row (id always "global"). The global kill switch
// stops ALL play at once; the wallet fields are the platform rules for
// the two wallets. coinsWithdrawable defaults NEVER — coins are
// play-only; flipping it only records the policy (no coin payout path
// exists) and is written to the AuditLog.
// P1 Batch 4 (O21): siteName (the display name in the header, default
// "Royale Gold"), supportContact (shown on the account page's Support
// form, empty = not shown), maintenanceMode (when ON, the homepage
// shows a plain maintenance message and game rooms show an unavailable
// screen; the owner + admin panels stay reachable).
model PlatformSettings {
  id                String   @id @default("global")
  globalKill        Boolean  @default(false)
  cashMinDeposit    Float  @default(1)
  cashMinStake      Float  @default(1)
  coinMinStake      Int      @default(1)
  conversionRate    Float  @default(5)
  coinsWithdrawable Boolean  @default(false)
  siteName          String   @default("Royale Gold")
  supportContact    String   @default("")
  maintenanceMode   Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}

// P1 Batch 1 (A18): promo codes — an admin's bonus offer any player can
// redeem (unlike referral codes, which are one per user and tie the
// player to the admin). A redemption credits the wallet and writes a
// BalanceAdjustment (kind "promo") + AuditLog "promo.redeem", so the
// ledger shows it. Expired or fully-used codes are rejected.
model PromoCode {
  id               String   @id @default(cuid())
  code             String   @unique
  bonusAmount      Float 
  bonusCurrency    String   // "cash" | "coins"
  maxUses          Int
  uses             Int      @default(0)
  expiresAt        DateTime?
  createdByAdminId String
  createdBy        User     @relation("PromoCreator", fields: [createdByAdminId], references: [id])
  createdAt        DateTime @default(now())

  redemptions PromoRedemption[]

  @@index([createdByAdminId, createdAt])
}

model PromoRedemption {
  id          String    @id @default(cuid())
  promoCodeId String
  promoCode   PromoCode @relation(fields: [promoCodeId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  redeemedAt  DateTime  @default(now())

  // One redemption per user per code.
  @@unique([promoCodeId, userId])
  @@index([userId, redeemedAt])
}

// P1 Batch 1 (A19): admin-only notes and tags on a player. The player
// never sees them — they live on the admin player detail (and tags also
// on the Players list rows) only.
model PlayerNote {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NotePlayer", fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User     @relation("NoteAuthor", fields: [adminId], references: [id])
  text      String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model PlayerTag {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("TagPlayer", fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User     @relation("TagAuthor", fields: [adminId], references: [id])
  tag       String
  createdAt DateTime @default(now())

  // A tag once per player.
  @@unique([userId, tag])
  @@index([userId, createdAt])
}

// P1 Batch 1 (A20): per-player limits, set by an admin (own downline
// only). Enforced server-side in settleGame (max stake, daily loss,
// cool-off), the play route (same, before the draw) and the deposit
// route (daily deposit max). Null = no limit on that field. Limits are
// per-player; the per-game economics (Batch 2 O10) still apply on top.
model PlayerLimit {
  id               String    @id @default(cuid())
  userId           String    @unique
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxStake         Float? 
  maxDepositPerDay Float? 
  maxLossPerDay    Float? 
  coolOffUntil     DateTime?
  // P2 Batch 1 (A29): self-exclusion — a hard stop: no deposit, play
  // or settle until the date (enforced in src/lib/limits.ts alongside
  // the cool-off). Reality check — the game room shows a session
  // summary every N minutes (0 = off).
  selfExcludedUntil   DateTime?
  selfExclusionReason String?
  realityCheckMinutes Int      @default(0)
  updatedBy        String?
  updatedAt        DateTime  @updatedAt
}

// P1 Batch 1 (A16): issued crash rounds, persisted so ANY past round can
// be verified (the in-memory map only keeps 15 minutes). The round route
// writes a row at issue time; the admin verify tool reads it back and
// recomputes the crash point + the SHA-256 commitment. The seed is only
// ever returned for a FINISHED round — a live round's seed stays secret.
model CrashRound {
  roundId    String   @id
  serverSeed String
  clientSeed String
  nonce      Int
  crashPoint Float 
  hash       String
  createdAt  DateTime @default(now())

  @@index([createdAt])
}

// P1 Batch 2 (A21): KYC submissions — a player submits a document type
// + a link to their ID document; an admin (own downline only) approves
// or rejects it. KYC is informational ONLY — it never blocks deposits
// or play (standing order). The document is a URL the player pastes —
// there is no file-hosting infra in this repo, so no storage backend
// is invented; the admin verifies from the URL.
model KycSubmission {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation("KycPlayer", fields: [userId], references: [id], onDelete: Cascade)
  documentType    String   // "national_id" | "passport" | "drivers_licence"
  documentUrl     String
  status          String   @default("pending") // "pending" | "approved" | "rejected"
  reviewedBy      String?
  reviewer        User?    @relation("KycReviewer", fields: [reviewedBy], references: [id])
  reviewedAt      DateTime?
  rejectionReason String?
  // P1 Batch 4 (O22): auto-approved by the URL-host allow-list rule
  // (KycSettings.autoApprove) — a host check, NOT a document check.
  autoApproved    Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// P1 Batch 2 (A23): in-app notifications from an admin to their own
// players. In-app only — no email, SMS or push (no messaging infra
// exists). A broadcast is one row per player.
model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("NotificationPlayer", fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User     @relation("NotificationAdmin", fields: [adminId], references: [id])
  title     String
  body      String
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

// P1 Batch 3 (O19): the owner's promotion engine — named campaigns on
// top of the admin bonus grant (A17) and promo codes (A18), which it
// does NOT change. Three types, no wagering requirements anywhere
// (there is no wagering system in this codebase):
//   deposit_match — match a % of a deposit up to `cap` GH₵, once per
//     player per promotion, credited automatically in the deposit route.
//   free_coins    — grant `coinAmount` coins on signup or on first
//     deposit (`trigger`), once per player per promotion, credited in
//     the register / deposit routes.
//   cashback      — return `percent`% of a day's net cash loss, capped
//     at `cap` GH₵. There is no cron infra, so cashback is paid by a
//     MANUAL owner action ("Pay cashback for {date}"), never automatic.
// `targetAdminId` null = every player; set = that admin's downline
// only. A promotion only grants while live: active AND now inside
// [startAt, endAt]. Grants are one row per credit, so the ledger and
// the audit log can prove every one.
model Promotion {
  id            String   @id @default(cuid())
  name          String
  type          String   // "deposit_match" | "free_coins" | "cashback"
  percent       Float  // match % / cashback % (0 for free_coins)
  cap           Float? // max grant per player, GH₵; null = no cap
  coinAmount    Int?     // free_coins only: coins granted
  trigger       String?  // free_coins only: "signup" | "first_deposit"
  startAt       DateTime
  endAt         DateTime?
  targetAdminId String?
  targetAdmin   User?    @relation("PromotionTarget", fields: [targetAdminId], references: [id])
  active        Boolean  @default(true)
  createdBy     String
  creator       User     @relation("PromotionCreator", fields: [createdBy], references: [id])
  createdAt     DateTime @default(now())

  grants PromotionGrant[]

  @@index([active, startAt])
}

model PromotionGrant {
  id          String   @id @default(cuid())
  promotionId String
  promotion   Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Float  // GH₵ for cash grants, whole coins for free_coins
  wallet      String   // "cash" | "coins"
  day         String   @default("") // cashback only: the YYYY-MM-DD loss day; "" otherwise
  createdAt   DateTime @default(now())

  @@index([promotionId, userId])
  @@index([userId, createdAt])
}

// P1 Batch 4 (O22): owner-level KYC/AML settings — a dedicated model
// (id always "global"), not fields on PlatformSettings, because it is
// a distinct settings domain with its own endpoint. acceptedTypes is a
// comma-separated list of document types the player submit form offers
// (default all three). autoApprove is OFF by default; when ON, a
// submission is auto-approved ONLY when its document URL host is on
// the allow-list (autoApproveHosts, comma-separated) — a URL-host
// check, NOT a document check (there is no verification service).
// withdrawalKycThreshold (GH₵, 0 = no requirement) flags withdrawal
// requests above it from players whose KYC is not Approved — a
// warning on the queue, NEVER a block.
model KycSettings {
  id                      String   @id @default("global")
  acceptedTypes           String   @default("national_id,passport,drivers_licence")
  autoApprove             Boolean  @default(false)
  autoApproveHosts        String   @default("")
  withdrawalKycThreshold  Float  @default(0)
  updatedAt               DateTime @updatedAt
}

// P1 Batch 4 (O20): announcements & banners — text only (no images,
// no links: no file hosting, no link infra). audience: "all" (everyone
// incl. signed-out), "players" (signed-in players), "admins" (admins +
// owner). A banner shows only while live: active AND now inside
// [startsAt, endAt].
model Announcement {
  id        String   @id @default(cuid())
  title     String
  body      String
  audience  String   @default("all") // "all" | "players" | "admins"
  active    Boolean  @default(true)
  startsAt  DateTime @default(now())
  endsAt    DateTime?
  createdBy String
  creator   User     @relation("AnnouncementCreator", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())

  @@index([active, startsAt])
}

// P2 Batch 1 (A25): CRM campaigns — an admin's named message to all
// their players, one segment, or hand-picked players. Sending creates
// one in-app Notification row per recipient (in-app only — no email,
// SMS or push) + an AuditLog "campaign.send" row. A campaign is sent
// ONCE — no resend, no edit after sending. targetPlayerIds is a JSON
// array of user ids (audience "players" only); segment is one of the
// A14 segment keys (audience "segment" only).
model Campaign {
  id              String   @id @default(cuid())
  name            String
  message         String
  audience        String   // "all" | "segment" | "players"
  segment         String?
  targetPlayerIds String?  // JSON array of user ids (audience "players")
  status          String   @default("draft") // "draft" | "sent"
  recipientCount  Int      @default(0)
  sentAt          DateTime?
  createdBy       String
  creator         User     @relation("CampaignCreator", fields: [createdBy], references: [id])
  createdAt       DateTime @default(now())

  @@index([createdBy, createdAt])
}

// P2 Batch 1 (A26): VIP tiers — a label + perks text only. A player's
// tier is computed live from their total deposited (the highest tier
// whose minDeposited they have reached). VIP changes NO economy,
// limits or payouts — the page says so. The owner edits the tiers on
// the owner panel; the admin panel only shows them. Seeded lazily with
// Bronze ≥ GH₵0, Silver ≥ GH₵500, Gold ≥ GH₵2,000 (src/lib/vip.ts).
model VipTier {
  id           String   @id @default(cuid())
  name         String
  minDeposited Float 
  perks        String   @default("") // comma-separated perk text
  sortOrder    Int      @default(0)
  createdBy    String
  creator      User     @relation("VipTierCreator", fields: [createdBy], references: [id])
  createdAt    DateTime @default(now())

  @@index([sortOrder])
}

// P2 Batch 1 (A27): tournaments & leaderboards. The leaderboard is
// computed LIVE from GameResult during the tournament — points = total
// staked in the tournament's game(s) inside [startAt, endAt] (gameSlug
// "all" = every game). TournamentEntry rows are the FROZEN final
// standings, written only when the tournament ends — never per bet.
// Ending pays the prize pool as a bonus credit to the winner (the
// admin picks the winner from the leaderboard, default rank 1) via the
// bonus-grant path: wallet credit + BalanceAdjustment kind "bonus" +
// AuditLog "bonus.grant".
model Tournament {
  id        String   @id @default(cuid())
  name      String
  gameSlug  String   // one of the 46 game slugs, or "all"
  startAt   DateTime
  endAt     DateTime
  prizePool Float 
  status    String   @default("upcoming") // "upcoming" | "active" | "ended"
  winnerId  String?
  winner    User?    @relation("TournamentWinner", fields: [winnerId], references: [id])
  createdBy String
  creator   User     @relation("TournamentCreator", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())

  entries TournamentEntry[]

  @@index([createdBy, createdAt])
  @@index([status, endAt])
}

model TournamentEntry {
  id           String   @id @default(cuid())
  tournamentId String
  tournament   Tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  points       Float  // total staked in the window, frozen at end
  rank         Int
  createdAt    DateTime @default(now())

  @@unique([tournamentId, userId])
  @@index([tournamentId, rank])
}

// P2 Batch 2 (O28): loyalty config — a dedicated model (id always
// "global"), like KycSettings, because it is a distinct settings
// domain with its own endpoint. pointsPerGhs is a READ-ONLY display
// rule (1 point per GH₵ 1 staked by default) — points are computed
// live from GameResult, there is NO points ledger. birthdayBonus is
// the GH₵ credited as a bonus on a player's birthday, paid ONCE per
// year by a MANUAL owner action (no cron exists) via the bonus-grant
// path; 0 = no birthday bonus.
model LoyaltySettings {
  id            String   @id @default("global")
  pointsPerGhs  Float  @default(1)
  birthdayBonus Float  @default(0)
  updatedAt     DateTime @updatedAt
}

// P2 Batch 2 (O28): one row per birthday bonus paid — a player is
// paid at most once per calendar year.
model BirthdayBonusGrant {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  amount    Float 
  createdAt DateTime @default(now())

  @@unique([userId, year])
  @@index([year, createdAt])
}

// P2 Batch 2 (O29): jackpots. The pot is HOUSE-funded: every cash
// stake in the jackpot's game(s) grows the pot by contributionPct% of
// the stake — a REPORTING number, never taken from any payout (the
// settle hook runs after the payout is computed). The pot itself is
// tracked in JackpotPot (one row per jackpot); currentPot here is a
// read mirror, kept in sync by the same transaction. Paying the pot
// credits the picked player as a bonus and resets the pot to the
// seed amount. Coins never feed a jackpot (play-money only).
model Jackpot {
  id             String   @id @default(cuid())
  name           String
  gameSlug       String   // one of the 46 game slugs, or "all"
  seedAmount     Float 
  contributionPct Float @default(1)
  currentPot     Float  @default(0)
  active         Boolean  @default(true)
  createdBy      String
  creator        User     @relation("JackpotCreator", fields: [createdBy], references: [id])
  createdAt      DateTime @default(now())

  pot JackpotPot?

  @@index([active, createdAt])
}

model JackpotPot {
  id        String   @id @default(cuid())
  jackpotId String   @unique
  jackpot   Jackpot  @relation(fields: [jackpotId], references: [id], onDelete: Cascade)
  pot       Float  @default(0)
  updatedAt DateTime @updatedAt
}

// P2 Batch 2 (O30): CMS pages — the owner edits title + body and
// toggles active/inactive. Seeded lazily with About, Terms, Privacy
// (src/lib/cms.ts). A page shows on /pages/[slug] only while active;
// the public endpoint 404s an inactive or missing page.
model CmsPage {
  slug      String   @id
  title     String
  body      String
  active    Boolean  @default(true)
  updatedBy String?
  updatedAt DateTime @updatedAt
}

// P2 Batch 2 (O31): automated risk rules — actions on top of the 4
// existing fraud signals (a/b/c/e; signal (d) failed-logins does not
// exist — there is no login-attempt data). Threshold meaning depends
// on the signal: (a) withdrawal-flags = minimum risk-flag count on
// the request (default 2); (b) rapid-withdrawals = requests in 24h
// (default 3); (c) deposit-no-play = GH₵ deposited in 24h with 0
// rounds in 24h (default 1000); (e) deposit-then-withdraw = minutes
// between deposit and withdrawal (default 60). Action: "flag" (the
// alert already appears in the fraud console — no extra effect),
// "block_player" (block the player at once), "hold_withdrawal" (set
// the withdrawal "held" for admin review — withdrawal requests only).
model RiskRule {
  id        String   @id @default(cuid())
  name      String
  signal    String   // "withdrawal-flags" | "rapid-withdrawals" | "deposit-no-play" | "deposit-then-withdraw"
  threshold Float 
  action    String   // "flag" | "block_player" | "hold_withdrawal"
  active    Boolean  @default(true)
  createdBy String
  creator   User     @relation("RiskRuleCreator", fields: [createdBy], references: [id])
  createdAt DateTime @default(now())

  @@index([active, signal])
}

// P2 Batch 2 (O33): multi-brand foundation — CONFIG records only.
// Seeded lazily with the one live brand (Royale Gold). A brand does
// NOT change any page, game or URL: there is no per-brand routing,
// no per-brand database and no per-brand theme switcher — the owner
// page says so plainly. Switching the live site to a brand needs
// per-brand routing + theming, which is not built.
model Brand {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  siteName      String
  primaryColor  String   @default("#F2C230")
  secondaryColor String  @default("#0C2B22")
  active        Boolean  @default(true)
  createdBy     String
  creator       User     @relation("BrandCreator", fields: [createdBy], references: [id])
  createdAt     DateTime @default(now())

  @@index([active, createdAt])
}
