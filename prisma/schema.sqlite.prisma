// Royale Gold — Prisma schema (PostgreSQL, production).
// Local dev on this VM has no Postgres; see README.md "Local database"
// for the clearly-labelled SQLite stand-in (prisma/schema.sqlite.prisma).
// NEVER point DATABASE_URL at invented Neon credentials.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // DEV-ONLY sqlite stand-in. Generated by scripts/make-sqlite-schema.mjs — do not edit by hand.
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String?  @unique
  phone            String?
  passwordHash     String
  role             String   @default("user")
  // REAL cash wallet (GH₵). Demo accounts start at 250.00.
  cashBalance      Float  @default(250.00)
  // SIM / demo-play balance (GH₵). Separate from cash; daily SIM claim tops this up.
  simBalance       Float  @default(1000.00)
  coins            Int      @default(10)
  commissionPct    Float?
  active           Boolean  @default(true)
  // P0 Batch 1 (A8): a blocked player cannot bet or deposit. The block
  // is set by an admin (own downline only) with a mandatory reason.
  blockedAt        DateTime?
  blockedReason    String?
  referredByAdminId String?
  referredByAdmin  User?    @relation("ReferredUsers", fields: [referredByAdminId], references: [id])
  referredUsers    User[]   @relation("ReferredUsers")
  referralCodeUsed String?
  xp               Int      @default(0)
  level            Int      @default(1)
  createdAt        DateTime @default(now())

  referralCodes   ReferralCode[]
  redemptions     Redemption[]
  deposits        DepositEvent[] @relation("Depositor")
  adminDeposits   DepositEvent[] @relation("CommissionAdmin")
  conversions     ConversionEvent[]
  gameResults     GameResult[]
  dailyClaims     DailyClaim[]
  achievements    Achievement[]
  // P0 Batch 1: withdrawals (request only — no real money moves),
  // manual balance adjustments, and the audit trail.
  withdrawals      Withdrawal[]       @relation("Withdrawer")
  adminWithdrawals Withdrawal[]       @relation("WithdrawalAdmin")
  adjustments      BalanceAdjustment[]
  adminAdjustments BalanceAdjustment[] @relation("AdjustmentAdmin")
  auditEntries     AuditLog[]          @relation("AuditActor")
}

model ReferralCode {
  id        String   @id @default(cuid())
  code      String   @unique
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  redemptions Redemption[]
}

model Redemption {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeId    String
  code      ReferralCode @relation(fields: [codeId], references: [id])
  coins     Int      @default(5)
  createdAt DateTime @default(now())

  // One referral redemption per user, ever.
  @@unique([userId])
}

model DepositEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("Depositor", fields: [userId], references: [id], onDelete: Cascade)
  adminId    String?
  admin      User?    @relation("CommissionAdmin", fields: [adminId], references: [id])
  amount     Float 
  method     String
  // Commission % in force at deposit time — frozen forever, never recomputed.
  pctInForce Float 
  commission Float 
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([userId, createdAt])
}

model ConversionEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // REAL cash debited (GH₵) — SIM is never involved in conversions.
  cashDebited Float 
  // Coins credited at the fixed rate GH₵5 = 1 coin. One-way only:
  // coins are never withdrawable or convertible back to cash.
  coinsGained Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model GameResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      String
  currency  String
  stake     Float 
  payout    Float 
  result    Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([game, createdAt])
}

model DailyClaim {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  claimedDate String
  streakDay   Int
  createdAt   DateTime @default(now())

  @@unique([userId, type, claimedDate])
  @@index([userId, type])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
}

model TriviaQuestion {
  id          String @id @default(cuid())
  question    String
  options     Json
  answerIndex Int
  category    String
}

// P0 Batch 1 (A5/O8): a withdrawal is a REQUEST only — no real money
// moves (deposits are demo cashier only). Status flow:
//   pending -> approved (admin approves; small amounts end here)
//   pending -> admin_approved (admin approves a LARGE amount) -> approved (owner approves second)
//   pending | admin_approved -> rejected (admin or owner, reason required)
// Large = over WITHDRAWAL_OWNER_THRESHOLD (GH₵ 500, src/lib/withdrawals.ts).
model Withdrawal {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("Withdrawer", fields: [userId], references: [id], onDelete: Cascade)
  // Referring admin at request time — scopes the admin queue. Null when
  // the player was not referred; the owner sees those in the global queue.
  adminId         String?
  admin           User?     @relation("WithdrawalAdmin", fields: [adminId], references: [id])
  amount          Float  
  method          String
  status          String    @default("pending")
  adminApprovedAt DateTime?
  decidedBy       String?
  reason          String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([adminId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// P0 Batch 1 (A7): a manual balance adjustment by an admin (own downline
// only). Written atomically with the balance change and an AuditLog row;
// the ledger (A6/O7) reads these back. Reason is mandatory.
model BalanceAdjustment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User     @relation("AdjustmentAdmin", fields: [adminId], references: [id])
  wallet    String   // "cash" | "coins"
  direction String   // "credit" | "debit"
  amount    Float 
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

// P0 Batch 1: the audit trail for money/admin actions (adjustments,
// blocks, withdrawal decisions). Append-only — nothing edits these rows.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id])
  action    String   // "balance.adjust" | "user.block" | "user.unblock" | "withdrawal.approve" | "withdrawal.reject" | "withdrawal.request"
  targetId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}
