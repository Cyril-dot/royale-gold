// Royale Gold — Prisma schema (PostgreSQL, production).
// Local dev on this VM has no Postgres; see README.md "Local database"
// for the clearly-labelled SQLite stand-in (prisma/schema.sqlite.prisma).
// NEVER point DATABASE_URL at invented Neon credentials.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // DEV-ONLY sqlite stand-in. Generated by scripts/make-sqlite-schema.mjs — do not edit by hand.
}

model User {
  id               String   @id @default(cuid())
  name             String
  email            String?  @unique
  phone            String?
  passwordHash     String
  role             String   @default("user")
  // REAL cash wallet (GH₵). Demo accounts start at 250.00.
  cashBalance      Float  @default(250.00)
  // SIM / demo-play balance (GH₵). Separate from cash; daily SIM claim tops this up.
  simBalance       Float  @default(1000.00)
  coins            Int      @default(10)
  commissionPct    Float?
  active           Boolean  @default(true)
  // P0 Batch 1 (A8): a blocked player cannot bet or deposit. The block
  // is set by an admin (own downline only) with a mandatory reason.
  blockedAt        DateTime?
  blockedReason    String?
  // P0 Batch 3 (O2/O3): per-section permissions as a JSON array of section
  // keys (see src/lib/rbac.ts ADMIN_SECTIONS). Null = all sections allowed
  // (backwards compatible: existing admins keep full access).
  permissions      String?
  // P0 Batch 3 (O15): session version — bumped to kill ALL of this user's
  // sessions at once (deactivate, "Kill all sessions"). A JWT carrying an
  // older version is rejected by getSessionUser (src/lib/auth.ts).
  sessionVersion   Int      @default(0)
  // P0 Batch 3 (A13): TOTP two-factor auth (opt-in per admin/owner).
  // totpSecret is the base32 secret; totpEnabled only flips after a code
  // is verified against it. The secret is never returned by any endpoint
  // after setup.
  totpSecret       String?
  totpEnabled      Boolean  @default(false)
  referredByAdminId String?
  referredByAdmin  User?    @relation("ReferredUsers", fields: [referredByAdminId], references: [id])
  referredUsers    User[]   @relation("ReferredUsers")
  referralCodeUsed String?
  xp               Int      @default(0)
  level            Int      @default(1)
  createdAt        DateTime @default(now())

  referralCodes   ReferralCode[]
  redemptions     Redemption[]
  deposits        DepositEvent[] @relation("Depositor")
  adminDeposits   DepositEvent[] @relation("CommissionAdmin")
  conversions     ConversionEvent[]
  gameResults     GameResult[]
  dailyClaims     DailyClaim[]
  achievements    Achievement[]
  // P0 Batch 1: withdrawals (request only — no real money moves),
  // manual balance adjustments, and the audit trail.
  withdrawals      Withdrawal[]       @relation("Withdrawer")
  adminWithdrawals Withdrawal[]       @relation("WithdrawalAdmin")
  adjustments      BalanceAdjustment[]
  adminAdjustments BalanceAdjustment[] @relation("AdjustmentAdmin")
  auditEntries     AuditLog[]          @relation("AuditActor")
  // P0 Batch 3 (O4): commission rules for this admin (a rule with adminId
  // null is the global default, not tied to a user). (O5) payouts received.
  commissionRules  CommissionRule[]    @relation("RuleAdmin")
  payouts          CommissionPayout[]  @relation("PayoutAdmin")
  // P0 Batch 3 (A11): tickets this player opened, and tickets assigned to
  // this admin (their own players' tickets only).
  ticketsOpened    Ticket[]            @relation("TicketPlayer")
  ticketsAssigned  Ticket[]            @relation("TicketAdmin")
  ticketMessages   TicketMessage[]
}

model ReferralCode {
  id        String   @id @default(cuid())
  code      String   @unique
  adminId   String
  admin     User     @relation(fields: [adminId], references: [id], onDelete: Cascade)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  redemptions Redemption[]
}

model Redemption {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeId    String
  code      ReferralCode @relation(fields: [codeId], references: [id])
  coins     Int      @default(5)
  createdAt DateTime @default(now())

  // One referral redemption per user, ever.
  @@unique([userId])
}

model DepositEvent {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation("Depositor", fields: [userId], references: [id], onDelete: Cascade)
  adminId    String?
  admin      User?    @relation("CommissionAdmin", fields: [adminId], references: [id])
  amount     Float 
  method     String
  // Commission % in force at deposit time — frozen forever, never recomputed.
  pctInForce Float 
  commission Float 
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
  @@index([userId, createdAt])
}

model ConversionEvent {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // REAL cash debited (GH₵) — SIM is never involved in conversions.
  cashDebited Float 
  // Coins credited at the fixed rate GH₵5 = 1 coin. One-way only:
  // coins are never withdrawable or convertible back to cash.
  coinsGained Int
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

model GameResult {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  game      String
  currency  String
  stake     Float 
  payout    Float 
  result    Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([game, createdAt])
}

model DailyClaim {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  claimedDate String
  streakDay   Int
  createdAt   DateTime @default(now())

  @@unique([userId, type, claimedDate])
  @@index([userId, type])
}

model Achievement {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key        String
  unlockedAt DateTime @default(now())

  @@unique([userId, key])
}

model TriviaQuestion {
  id          String @id @default(cuid())
  question    String
  options     Json
  answerIndex Int
  category    String
}

// P0 Batch 1 (A5/O8): a withdrawal is a REQUEST only — no real money
// moves (deposits are demo cashier only). Status flow:
//   pending -> approved (admin approves; small amounts end here)
//   pending -> admin_approved (admin approves a LARGE amount) -> approved (owner approves second)
//   pending | admin_approved -> rejected (admin or owner, reason required)
// Large = over WITHDRAWAL_OWNER_THRESHOLD (GH₵ 500, src/lib/withdrawals.ts).
model Withdrawal {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation("Withdrawer", fields: [userId], references: [id], onDelete: Cascade)
  // Referring admin at request time — scopes the admin queue. Null when
  // the player was not referred; the owner sees those in the global queue.
  adminId         String?
  admin           User?     @relation("WithdrawalAdmin", fields: [adminId], references: [id])
  amount          Float  
  method          String
  status          String    @default("pending")
  adminApprovedAt DateTime?
  decidedBy       String?
  reason          String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([adminId, createdAt])
  @@index([userId, createdAt])
  @@index([status, createdAt])
}

// P0 Batch 1 (A7): a manual balance adjustment by an admin (own downline
// only). Written atomically with the balance change and an AuditLog row;
// the ledger (A6/O7) reads these back. Reason is mandatory.
model BalanceAdjustment {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  adminId   String
  admin     User     @relation("AdjustmentAdmin", fields: [adminId], references: [id])
  wallet    String   // "cash" | "coins"
  direction String   // "credit" | "debit"
  amount    Float 
  reason    String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

// P0 Batch 1: the audit trail for money/admin actions (adjustments,
// blocks, withdrawal decisions). Append-only — nothing edits these rows.
// P0 Batch 3 extends the action set: commission.rule.* (rules engine),
// commission.payout (settlement), admin.permission / admin.kill_sessions /
// admin.deactivate, auth.2fa.enable / auth.2fa.disable, ticket.create /
// ticket.reply / ticket.close.
model AuditLog {
  id        String   @id @default(cuid())
  actorId   String
  actor     User     @relation("AuditActor", fields: [actorId], references: [id])
  action    String   // "balance.adjust" | "user.block" | "user.unblock" | "withdrawal.approve" | "withdrawal.reject" | "withdrawal.request" | "commission.rule.set" | "commission.payout" | "admin.permission" | "admin.kill_sessions" | "admin.deactivate" | "auth.2fa.enable" | "auth.2fa.disable" | "ticket.create" | "ticket.reply" | "ticket.close"
  targetId  String?
  detail    String?
  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([action, createdAt])
}

// P0 Batch 3 (O4): the commission rules engine. Replaces the flat % per
// admin (User.commissionPct, kept as the legacy fallback). One rule per
// admin per model, versioned by effectiveFrom — the rule in force on a
// day (latest effectiveFrom <= that day) is what that day pays. A rule
// with adminId null is the GLOBAL default: it applies to every admin
// without their own rule. model: "revshare" (% of the player's net loss
// = stakes - payouts) or "turnover" (% of total stakes). Rate is a %
// (e.g. 10 = 10%). Rules are never deleted — a new rule supersedes the
// old one from its effectiveFrom date, so past days stay frozen.
model CommissionRule {
  id            String   @id @default(cuid())
  adminId       String?
  admin         User?    @relation("RuleAdmin", fields: [adminId], references: [id])
  model         String   // "revshare" | "turnover"
  rate          Float 
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())

  @@index([adminId, effectiveFrom])
}

// P0 Batch 3 (O5): commission settlement & payouts. A payout is the owner
// recording that commission was actually paid to an admin (amount +
// method + reference). Owed per admin per period is RECOMPUTED from the
// ledger (src/lib/commission.ts); paid is the sum of these rows; balance
// = owed - paid. A payout writes to the ledger (type "payout") and the
// AuditLog, so the numbers cannot disagree.
model CommissionPayout {
  id         String   @id @default(cuid())
  adminId    String
  admin      User     @relation("PayoutAdmin", fields: [adminId], references: [id])
  amount     Float 
  method     String   // e.g. "MTN", "Telecel", "AirtelTigo", "bank", "cash"
  reference  String?
  periodFrom String?  // "YYYY-MM-DD" — the period this payout covers
  periodTo   String?
  createdBy  String   // owner id who recorded it
  createdAt  DateTime @default(now())

  @@index([adminId, createdAt])
}

// P0 Batch 3 (A11): support tickets — tickets + replies only, no live
// chat. A player opens a ticket from the account page; it is assigned to
// their referring admin (adminId null when the player was not referred —
// the owner sees those). Status: "open" -> "answered" -> "closed".
model Ticket {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation("TicketPlayer", fields: [userId], references: [id], onDelete: Cascade)
  adminId   String?
  admin     User?    @relation("TicketAdmin", fields: [adminId], references: [id])
  subject   String
  status    String   @default("open")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages TicketMessage[]

  @@index([adminId, status, createdAt])
  @@index([userId, createdAt])
}

model TicketMessage {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderId  String
  sender    User     @relation(fields: [senderId], references: [id])
  senderRole String  // "user" | "admin"
  body      String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

// P0 Batch 2 (O9/O10/O11): per-game owner control. One row per game the
// owner has touched; a game with NO row runs on the catalogue defaults
// (src/lib/games.ts): visible, not killed, no bet/payout caps, the
// catalogue maxMultiplier. Null numeric = no override (use the default).
model GameConfig {
  slug          String   @id // matches games.ts slug
  visible       Boolean  @default(true)
  killed        Boolean  @default(false)
  minBet        Float?
  maxBet        Float?
  maxPayout     Float?
  maxMultiplier Float?
  updatedBy     String?
  updatedAt     DateTime @updatedAt
}

// P0 Batch 2 (O12): per-method deposit control. Rows are seeded lazily
// (a method with no row is enabled with no min/max). Deposits stay demo
// cashier only — this toggles/limits the methods, it connects no gateway.
model PaymentMethodConfig {
  method     String   @id // "MTN" | "Telecel" | "AirtelTigo" | "card"
  enabled    Boolean  @default(true)
  minDeposit Float?
  maxDeposit Float?
  updatedAt  DateTime @updatedAt
}

// P0 Batch 2 (O11 global kill + O13 wallet config): the platform's
// single settings row (id always "global"). The global kill switch
// stops ALL play at once; the wallet fields are the platform rules for
// the two wallets. coinsWithdrawable defaults NEVER — coins are
// play-only; flipping it only records the policy (no coin payout path
// exists) and is written to the AuditLog.
model PlatformSettings {
  id                String   @id @default("global")
  globalKill        Boolean  @default(false)
  cashMinDeposit    Float  @default(1)
  cashMinStake      Float  @default(1)
  coinMinStake      Int      @default(1)
  conversionRate    Float  @default(5)
  coinsWithdrawable Boolean  @default(false)
  updatedAt         DateTime @updatedAt
}
